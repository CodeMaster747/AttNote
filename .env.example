# Copy this file to `.env` and fill in values from your Firebase project.
# `.env` is gitignored — do not commit real credentials.
#
# Get these from Firebase Console -> Project Settings -> Your apps -> Web app config.
# (Project Settings -> General -> "Your apps" section.)

# --- Firebase Web config ---
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_APP_ID=your-firebase-web-app-id
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Google Sign-In ---
# OAuth 2.0 "Web application" client ID from Google Cloud Console
# (APIs & Services -> Credentials). Required for google_sign_in on Web.
GOOGLE_OAUTH_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
