rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    // Data of a subject document at users/{ownerUid}/subjects/{subjectId}.
    function subjectData(ownerUid, subjectId) {
      return get(
        /databases/$(database)/documents/users/$(ownerUid)/subjects/$(subjectId)
      ).data;
    }

    // True if the signed-in user is enrolled in the given subject.
    function isEnrolled(ownerUid, subjectId) {
      let data = subjectData(ownerUid, subjectId);
      return isSignedIn() &&
        data.studentIds is list &&
        request.auth.uid in data.studentIds;
    }

    // ---- User profiles ----
    // Owners manage their own profile. Staff may read any profile so they can
    // look up students by email (add-by-email) and show the roster.
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // ---- Subjects ----
    // Owner: full control over subjects in their own collection.
    // Enrolled student: may READ the staff's source subject document.
    // Staff: may create/read/update/delete a student's mirrored copy that
    //        links back to them (linkedStaffId == staff uid).
    match /users/{uid}/subjects/{subjectId} {
      allow read: if isOwner(uid)
        || (isSignedIn() && resource.data.studentIds is list
            && request.auth.uid in resource.data.studentIds)
        || (isSignedIn() && resource.data.linkedStaffId == request.auth.uid);
      allow create: if isOwner(uid)
        || (isStaff() && request.resource.data.linkedStaffId == request.auth.uid);
      allow update: if isOwner(uid)
        || (isStaff() && resource.data.linkedStaffId == request.auth.uid);
      allow delete: if isOwner(uid)
        || (isStaff() && resource.data.linkedStaffId == request.auth.uid);
    }

    // ---- Attendance ----
    // Owner (student) full access; the linked staff may read/write it too
    // (record attendance for the roster, read absences for the Course Guide).
    match /users/{uid}/subjects/{subjectId}/attendance/{attendanceId} {
      allow read, write: if isOwner(uid)
        || (isSignedIn()
            && subjectData(uid, subjectId).linkedStaffId == request.auth.uid);
    }

    // ---- Staff course content (read-only for enrolled students) ----
    match /users/{uid}/subjects/{subjectId}/dayPlans/{docId} {
      allow read: if isOwner(uid) || isEnrolled(uid, subjectId);
      allow write: if isOwner(uid);
    }
    match /users/{uid}/subjects/{subjectId}/sections/{docId} {
      allow read: if isOwner(uid) || isEnrolled(uid, subjectId);
      allow write: if isOwner(uid);
    }
    match /users/{uid}/subjects/{subjectId}/tests/{docId} {
      allow read: if isOwner(uid) || isEnrolled(uid, subjectId);
      allow write: if isOwner(uid);
    }
    match /users/{uid}/subjects/{subjectId}/guide/{docId} {
      allow read: if isOwner(uid) || isEnrolled(uid, subjectId);
      allow write: if isOwner(uid);
    }

    // Lock down everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
